# ---- macOS ----
.DS_Store
*.swp
*~

# ---- Python ----
__pycache__/
*.py[cod]

# ---- ESP-IDF firmware (generated / fetched — reproducible from source) ----
# build output
firmware/build/
# clangd / IDE index cache
firmware/.cache/
# managed components are re-fetched from dependencies.lock on `idf.py build`.
# dependencies.lock IS committed (pins exact versions) — do NOT ignore it.
firmware/managed_components/
# sdkconfig is machine-local + regenerated from sdkconfig.defaults*.
# The sdkconfig.defaults* files ARE committed.
firmware/sdkconfig
firmware/sdkconfig.old

# ---- Local-only capture fixtures (SECURITY-CRITICAL — never commit) ----
# These contain the account email / spend aggregates / private project paths.
# docs/SECURITY.md treats the publish path as a private single-user channel;
# these must never enter version control. (See §"Project exception".)
docs/references/codexbar-usage-claude.sample.json
docs/references/codexbar-cost-cache-claude.sample.json
docs/references/codexbar-raw-claude.sample.json
