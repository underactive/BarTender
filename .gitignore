# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon?

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Secrets / credentials --------------------------------------------------
# This project deliberately keeps credentials OUT of the repo. CodexBar's
# ~/.codexbar/config.json already holds a plaintext OpenRouter API key, and
# Prompt 2 (Upstash/Railway publisher) will add more. Never commit these.
.env
.env.*
*.local
secrets*
*.secret
*.pem
*-credentials.json

# --- Local run output -------------------------------------------------------
# scripts/codexbar-stats.sh uses mktemp in $TMPDIR (already outside the repo);
# these cover any logs/snapshots a user redirects into the tree.
*.log
tmp/
*.tmp

# --- ESP-IDF firmware (Prompt 3) -------------------------------------------
# Build artifacts + auto-generated/auto-fetched files. sdkconfig.defaults*
# ARE committed (build inputs); the merged `sdkconfig` is generated.
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock
firmware/.envrc
build/

# clangd / IDE index cache (created when a language server reads the tree)
.cache/
.clangd/
compile_commands.json
