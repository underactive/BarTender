# firmware/sdkconfig.defaults.esp32s3
# Freenove ESP32-S3 2.8" (fnk0104): ESP32-S3, 16 MB OPI flash, 8 MB OPI PSRAM,
# ILI9341 320x240 SPI, FT6336G touch. (Adapted from clawd-tank's overlay.)

CONFIG_BOARD_FREENOVE_S3_28=y

# Flash: 16 MB, Octal
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_OPI=y

# PSRAM: 8 MB Octal @ 80 MHz; let WiFi/LWIP buffers land in PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Dual-core (explicit; guards against unicore carryover)
CONFIG_FREERTOS_UNICORE=n

# Console on the native USB port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
