# firmware/sdkconfig.defaults
# Board-agnostic defaults. Per-target overlay: sdkconfig.defaults.esp32s3.
# (No BLE — unlike clawd-tank, this firmware is WiFi-only.)

# SPI LCD host
CONFIG_LCD_HOST_SPI2=y

# Custom partition table (vendored from clawd-tank: 8 MB app, 24 KB nvs)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# HTTPS: upstash_roots.h supplies ISRG Root X2 to mbedTLS's normal chain
# validator. Leave ESP-IDF's compact bundle off: v5.3.2 rejects Upstash's
# valid 2026 Let's Encrypt hierarchy in its bundle callback.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# The board has 8 MB PSRAM. Keep scarce internal RAM available for the SHA DMA
# driver during TLS handshakes; large mbedTLS buffers may use the general heap,
# and are allocated only while actively sending or receiving.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Default board (overlay re-affirms this for the esp32s3 target)
CONFIG_BOARD_FREENOVE_S3_28=y
